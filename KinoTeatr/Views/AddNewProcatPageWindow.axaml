<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KinoTeatr.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:KinoTeatr.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="KinoTeatr.Views.AddNewProcatPageWindow"
        x:DataType="vm:AddNewProcatViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="KinoTeatr">

    <Design.DataContext>
        <vm:AddNewProcatViewModel/>
    </Design.DataContext>
    <Grid RowDefinitions="15*, 85*"  Background="#1E1E1E">
        <TextBlock Grid.Row="0" VerticalAlignment="Center" Grid.ColumnSpan="3" Text="Добавление проката" Foreground="Orange" FontSize="18" HorizontalAlignment="Center"/>
        <Image VerticalAlignment="Center" HorizontalAlignment="Left" Source="/Assets/Images/group.png" Width="30" Margin="10,0,0,0"/>
       <StackPanel Grid.Row="1">
          <TextBlock Foreground="White" Text="Выберите кинотетр"/>
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GettedCinemas}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding SelectedCinema, Mode=TwoWay}"/>
          <TextBlock Foreground="White" Text="Выберите фильм"/>
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GettedVideos}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding SelectedVideo, Mode=TwoWay}"/>
          <TextBlock Foreground="White" Text="Дата выхода"/>
          <TextBlock Text="{Binding SelectedVideo.DateEnd}" Foreground="Orange"/>
          <TextBlock Foreground="White" Text="Общие сборы"/>
          <NumericUpDown Foreground="Orange" Minimum="0" FormatString="0.00" Increment="0.01" Value="{Binding Revenue}"/>
          <TextBlock Foreground="White" Text="Рейтинг"/>
          <NumericUpDown Foreground="Orange" Minimum="0" Maximum="10" FormatString="0.00" Increment="0.01" Value="{Binding Rating}"/>
          <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" HorizontalAlignment="Center"/>
           <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"> 
               <Button Margin="0,0,5,0" Foreground="White" Background="#2DED2D" Content="Добавить" Command="{Binding AddNewProcatCommand}" CommandParameter="{Binding $parent[Window]}">
                   <Button.Styles>
                       <Style Selector=":pointerover /template/ ContentPresenter">
                           <Setter Property="Background" Value="#6CF26C"/>
                       </Style>
                   </Button.Styles>
               </Button>
               <Button Foreground="White" Background="Red" Content="Назад" Command="{x:Static helpers:PublicViewModelMethods.CloseCurrentWindowCommand}" CommandParameter="{Binding $parent[Window]}">
                   <Button.Styles>
                       <Style Selector=":pointerover /template/ ContentPresenter">
                           <Setter Property="Background" Value="#E04848"/>
                       </Style>
                   </Button.Styles>
               </Button>
           </StackPanel>
       </StackPanel>
    </Grid>
</Window>
