<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KinoTeatr.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:KinoTeatr.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
        x:Class="KinoTeatr.Views.AddStaffInGroupPageWindow"
        x:DataType="vm:AddStaffInGroupPageViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="KinoTeatr">

    <Design.DataContext>
        <vm:AddStaffInGroupPageViewModel/>
    </Design.DataContext>
    <Grid RowDefinitions="15*, 85*"  Background="#1E1E1E">
        <TextBlock Grid.Row="0" VerticalAlignment="Center" Grid.ColumnSpan="3" Text="Добавление съемочной группы" Foreground="Orange" FontSize="18" HorizontalAlignment="Center"/>
        <Image VerticalAlignment="Center" HorizontalAlignment="Left" Source="/Assets/Images/projects.png" Width="30" Margin="10,0,0,0"/>
       <StackPanel Grid.Row="1">
           <TextBlock Text="Сотрудник" Foreground="White"/>
           <ComboBox SelectedItem="{Binding SelectedStaff, Mode=TwoWay}" ItemsSource="{Binding GettedStaff}" DisplayMemberBinding="{Binding Name}" Foreground="Orange" PlaceholderForeground="White" PlaceholderText="Выберите проект" Text="Выбранный проект" HorizontalAlignment="Stretch"/>
           <TextBlock Text="Должность" Foreground="White"/>
           <ComboBox SelectedItem="{Binding SelectedRole, Mode=TwoWay}" ItemsSource="{Binding GettedRoles}" DisplayMemberBinding="{Binding Name}" Foreground="Orange" PlaceholderForeground="White" PlaceholderText="Выберите проект" Text="Выбранный проект" HorizontalAlignment="Stretch"/>
           <TextBlock Text="{Binding }" Foreground="Red" HorizontalAlignment="Center"/>
           <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"> 
               <Button Margin="0,0,5,0" Foreground="White" Background="#2DED2D" Content="Добавить" Command="{Binding AddStaffInGroupCommand}" CommandParameter="{Binding $parent[Window]}">
                   <Button.Styles>
                       <Style Selector=":pointerover /template/ ContentPresenter">
                           <Setter Property="Background" Value="#6CF26C"/>
                       </Style>
                   </Button.Styles>
               </Button>
               <Button Foreground="White" Background="Red" Content="Назад" Command="{x:Static helpers:PublicViewModelMethods.CloseCurrentWindowCommand}" CommandParameter="{Binding $parent[Window]}">
                   <Button.Styles>
                       <Style Selector=":pointerover /template/ ContentPresenter">
                           <Setter Property="Background" Value="#E04848"/>
                       </Style>
                   </Button.Styles>
               </Button>
           </StackPanel>
       </StackPanel>
    </Grid>
</Window>
