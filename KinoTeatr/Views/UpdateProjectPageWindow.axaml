<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KinoTeatr.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:KinoTeatr.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="KinoTeatr.Views.UpdateProjectPageWindow"
        x:DataType="vm:UpdateProjectViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="KinoTeatr">

    <!-- <Design.DataContext>
        <vm:UpdateProjectViewModel/>
    </Design.DataContext> -->
    <Grid RowDefinitions="15*, 85*" ColumnDefinitions="45*, 5*, 45*" Background="#1E1E1E">
        <TextBlock Grid.Row="0" VerticalAlignment="Center" Grid.ColumnSpan="3" Text="{Binding VideoProductDTO.Name}" Foreground="Orange" FontSize="18" HorizontalAlignment="Center"/>
        <Image VerticalAlignment="Center" HorizontalAlignment="Left" Source="/Assets/Images/projects.png" Width="30" Margin="10,0,0,0"/>
       <StackPanel Grid.Row="1">
           <TextBlock Text="Название:" Foreground="White"/>
           <TextBox Text="{Binding NameProject}" PlaceholderText="{Binding VideoProductDTO.Name}" Foreground="Orange" Background="#474444" Margin="0,0,0,10" PlaceholderForeground="White" />
           <TextBlock Text="Бюджет:" Foreground="White"/>
           <NumericUpDown Value="{Binding Budget}" Increment="0.1" FormatString="0.00" Minimum="0" PlaceholderText="{Binding VideoProductDTO.Budget}" Foreground="Orange" Background="#474444" Margin="0,0,0,10" PlaceholderForeground="White" />
           <TextBlock Text="Сериал/Фильм:" Foreground="White"/>
           <ComboBox HorizontalAlignment="Stretch" SelectedItem="{Binding SelectedVidVideo}" ItemsSource="{Binding GettedTypeVideo}" Foreground="Orange" DisplayMemberBinding="{Binding Name}" PlaceholderText="{Binding VideoProductDTO.VidVideoName}" Background="#474444" PlaceholderForeground="White"  Margin="0,0,0,10"/>
           <TextBlock Text="Дата начала:" Foreground="White"/>
           <DatePicker SelectedDate="{Binding VideoProductDTO.DateStart}" IsEnabled="False" Foreground="Orange" Background="#474444" Margin="0,0,0,10" >
                <DatePicker.Styles>
                    <Style Selector=":disabled /template/ ContentPresenter">
                        <Setter Property="Foreground" Value="orange"/>
                        <Setter Property="Background" Value="#474444"/>
                    </Style>
                </DatePicker.Styles>
           </DatePicker>
           <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" HorizontalAlignment="Center"/>
       </StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="2">
           <TextBlock Text="Текущий статус:" Foreground="White"/>
           <ComboBox HorizontalAlignment="Stretch" SelectedItem="{Binding SelectedStatus}" ItemsSource="{Binding GettedStatuses}" DisplayMemberBinding="{Binding Name}" PlaceholderText="{Binding VideoProductDTO.StatusVideoName}" Foreground="Orange" Background="#474444" Margin="0,0,0,10" PlaceholderForeground="White" />
           <TextBlock Text="Возрастное ограничение:" Foreground="White"/>
           <ComboBox HorizontalAlignment="Stretch" SelectedItem="{Binding SelectedAdult}" ItemsSource="{Binding GettedAdults}" PlaceholderText="{Binding VideoProductDTO.AdultVideoName}" DisplayMemberBinding="{Binding Name}" Foreground="Orange" Background="#474444" Margin="0,0,0,10" PlaceholderForeground="White" />
           <TextBlock Text="Идея продукта:" Foreground="White"/>
           <TextBox Text="{Binding Idea}" PlaceholderText="{Binding VideoProductDTO.Idea}" Foreground="Orange" Background="#474444" Margin="0,0,0,10" PlaceholderForeground="White" />
           <TextBlock Text="Конечная дата:" Foreground="White"/>
           <DatePicker SelectedDate="{Binding SelectedDateEnd}" Foreground="Orange" Background="#474444" Margin="0,0,0,10"/>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Foreground="White" Background="#17EE22" Margin="10,0,0,0" Cursor="Hand" Command="{Binding UpdateProjectCommand}" CommandParameter="{Binding $parent[Window]}">
                    <Button.Styles>
                        <Style Selector=":pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#5EEB5E"/>
                        </Style>
                    </Button.Styles>
                </Button>
                
               <Button Content="Назад" Foreground="White" Background="Red" Margin="10,0,0,0" Cursor="Hand" Command="{x:Static helpers:PublicViewModelMethods.CloseCurrentWindowCommand}" CommandParameter="{Binding $parent[Window]}">
                    <Button.Styles>
                        <Style Selector=":pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#F84747"/>
                        </Style>
                    </Button.Styles>
               </Button>
            </StackPanel>
       </StackPanel>
        
    </Grid>
</Window>
