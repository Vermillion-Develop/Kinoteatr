<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KinoTeatr.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:KinoTeatr.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="350"
        x:Class="KinoTeatr.Views.AddNewGraphicPageWindow"
        x:DataType="vm:AddNewGraphicPageViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="KinoTeatr">

    <Design.DataContext>
        <vm:AddNewGraphicPageViewModel/>
    </Design.DataContext>
    <Grid RowDefinitions="15*, 85*"  Background="#1E1E1E">
        <TextBlock Grid.Row="0" VerticalAlignment="Center" Grid.ColumnSpan="3" Text="Добавление графика съемок" Foreground="Orange" FontSize="18" HorizontalAlignment="Center"/>
        <Image VerticalAlignment="Center" HorizontalAlignment="Left" Source="/Assets/Images/group.png" Width="30" Margin="10,0,0,0"/>
       <StackPanel Grid.Row="1">
           <ComboBox SelectedItem="{Binding SelectedProduct, Mode=TwoWay}" ItemsSource="{Binding GettedProjects}" DisplayMemberBinding="{Binding Name}" Foreground="Orange" PlaceholderForeground="White" PlaceholderText="Выберите проект" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
           <ComboBox SelectedItem="{Binding SelectedScene, Mode=TwoWay}" ItemsSource="{Binding GettedScenes}" DisplayMemberBinding="{Binding Name}" Foreground="Orange" PlaceholderForeground="White" PlaceholderText="Выберите сцену"  Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
           <ComboBox SelectedItem="{Binding SelectedArea, Mode=TwoWay}" ItemsSource="{Binding GettedAreas}" DisplayMemberBinding="{Binding FullName}" Foreground="Orange" PlaceholderForeground="White" PlaceholderText="Выберите площадку" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
           <ComboBox SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" ItemsSource="{Binding GettedGroup}" DisplayMemberBinding="{Binding Name}" Foreground="Orange" PlaceholderForeground="White" PlaceholderText="Выберите группу" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
           <ComboBox SelectedItem="{Binding SelectedTime, Mode=TwoWay}" ItemsSource="{Binding GettedTimes}" Foreground="Orange" PlaceholderForeground="White" PlaceholderText="Выберите время" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>
           <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Foreground="Orange" HorizontalAlignment="Stretch"/>
           <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" HorizontalAlignment="Center"/>
           <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"> 
               <Button Margin="0,0,5,0" Foreground="White" Background="#2DED2D" Content="Добавить" Command="{Binding AddNewGraphCommand}" CommandParameter="{Binding $parent[Window]}">
                   <Button.Styles>
                       <Style Selector=":pointerover /template/ ContentPresenter">
                           <Setter Property="Background" Value="#6CF26C"/>
                       </Style>
                   </Button.Styles>
               </Button>
               <Button Foreground="White" Background="Red" Content="Назад" Command="{x:Static helpers:PublicViewModelMethods.CloseCurrentWindowCommand}" CommandParameter="{Binding $parent[Window]}">
                   <Button.Styles>
                       <Style Selector=":pointerover /template/ ContentPresenter">
                           <Setter Property="Background" Value="#E04848"/>
                       </Style>
                   </Button.Styles>
               </Button>
           </StackPanel>
       </StackPanel>
    </Grid>
</Window>
