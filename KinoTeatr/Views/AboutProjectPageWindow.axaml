<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KinoTeatr.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:KinoTeatr.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="250"
        x:Class="KinoTeatr.Views.AboutProjectPageWindow"
        x:DataType="vm:AboutProjectViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="KinoTeatr">

    <Design.DataContext>
        <vm:AboutProjectViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="15*, 85*" ColumnDefinitions="45*, 5*, 45*" Background="#1E1E1E">
        <TextBlock Grid.Row="0" VerticalAlignment="Center" Grid.ColumnSpan="3" Text="{Binding VideoProductDTO.Name}" Foreground="Orange" FontSize="18" HorizontalAlignment="Center"/>
        <Image VerticalAlignment="Center" HorizontalAlignment="Left" Source="/Assets/Images/projects.png" Width="30" Margin="10,0,0,0"/>
       <StackPanel Grid.Row="1">
           <TextBlock Text="Название:" Foreground="White"/>
           <TextBlock Text="{Binding VideoProductDTO.Name}" Foreground="Orange" Background="#474444" Margin="0,0,0,10"/>
           <TextBlock Text="Бюджет:" Foreground="White"/>
           <TextBlock Text="{Binding VideoProductDTO.Budget}" Foreground="Orange" Background="#474444" Margin="0,0,0,10"/>
           <TextBlock Text="Сериал/Фильм:" Foreground="White"/>
           <TextBlock Text="{Binding VideoProductDTO.VidVideoName}" Foreground="Orange" Background="#474444" Margin="0,0,0,10"/>
           <TextBlock Text="Дата начала:" Foreground="White"/>
           <TextBlock Text="{Binding VideoProductDTO.DateStart}" Foreground="Orange" Background="#474444" Margin="0,0,0,10"/>
       </StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="2">
           <TextBlock Text="Текущий статус:" Foreground="White"/>
           <TextBlock Text="{Binding VideoProductDTO.StatusVideoName}" Foreground="Orange" Background="#474444" Margin="0,0,0,10"/>
           <TextBlock Text="Возрастное ограничение:" Foreground="White"/>
           <TextBlock Text="{Binding VideoProductDTO.AdultVideoName}" Foreground="Orange" Background="#474444" Margin="0,0,0,10"/>
           <TextBlock Text="Идея продукта:" Foreground="White"/>
           <TextBlock Text="{Binding VideoProductDTO.Idea}" Foreground="Orange" Background="#474444" Margin="0,0,0,10"/>
           <TextBlock Text="Конечная дата:" Foreground="White"/>
           <TextBlock Text="{Binding VideoProductDTO.DateEnd}" Foreground="Orange" Background="#474444" Margin="0,0,0,10"/>
           <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Назад" Foreground="White" Background="Red" Margin="10,0,0,0" Cursor="Hand" Command="{x:Static helpers:PublicViewModelMethods.CloseCurrentWindowCommand}" CommandParameter="{Binding $parent[Window]}"/>
            </StackPanel>
       </StackPanel>
        
    </Grid>
</Window>
